{
  "name": "@zohan/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./trpc/routers/_app": "./trpc/routers/_app.ts",
    "./db/schema": "./db/schema.ts",
    "./db/types": "./db/types.ts",
    "./db/queries": "./db/queries.ts",
    "./types/geojson": "./types/geojson.ts",
    "./types/tree-api-types": "./types/tree-api-types.ts",
    "./services/tree-api-client": "./services/tree-api-client.ts",
    "./config": "./config/index.ts"
  },
  "scripts": {
    "dev": "cross-env DOTENV_CONFIG_PATH=../../.env tsx watch index.ts",
    "build": "cross-env DOTENV_CONFIG_PATH=../../.env node esbuild.build.mjs",
    "start": "cross-env DOTENV_CONFIG_PATH=../../.env node dist/index.js",
    "start:prod": "node dist/index.js",
    "db:generate": "cross-env DOTENV_CONFIG_PATH=../../.env PORT=3000 drizzle-kit generate",
    "db:migrate": "cross-env DOTENV_CONFIG_PATH=../../.env PORT=3000 drizzle-kit migrate",
    "db:push": "cross-env DOTENV_CONFIG_PATH=../../.env PORT=3000 drizzle-kit push",
    "db:studio": "cross-env DOTENV_CONFIG_PATH=../../.env PORT=3000 drizzle-kit studio",
    "db:seed": "cross-env DOTENV_CONFIG_PATH=../../.env tsx db/seed.ts"
  },
  "dependencies": {
    "@trpc/server": "^11.4.1",
    "axios": "^1.11.0",
    "cors": "^2.8.5",
    "dotenv": "^17.0.0",
    "express": "^4.18.2",
    "pdfjs-dist": "^5.3.31",
    "superjson": "^2.2.2",
    "zod": "^3.25.64"
  },
  "devDependencies": {
    "@types/node": "^24.5.0",
    "cross-env": "^7.0.3",
    "tsx": "^4.20.3",
    "esbuild": "^0.24.0",
    "typescript": "~5.8.3"
  }
}
